---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Linux Error & Log Explainer | Tool Hub">
  <style>
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(108,99,255,0.12);
      border: 1px solid rgba(108,99,255,0.3);
      color: #8b85ff;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 4px 12px;
      border-radius: 999px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 1.2rem;
    }

    .page-title {
      font-size: clamp(1.8rem, 5vw, 2.8rem);
      font-weight: 800;
      color: var(--text-primary);
      line-height: 1.15;
      letter-spacing: -0.03em;
      margin-bottom: 0.75rem;
    }

    .page-title span { color: #8b85ff; }

    .page-subtitle {
      color: var(--text-secondary);
      font-size: clamp(0.9rem, 2vw, 1rem);
      max-width: 520px;
      margin: 0 auto 2.5rem;
      line-height: 1.6;
      min-height: 48px; /* ⚡ Added to prevent jump during typing */
    }

    /* ⚡ New Cursor Animation */
    .type-cursor { display: inline-block; width: 2px; color: #8b85ff; animation: cursorBlink 0.8s step-end infinite; margin-left: 2px; font-weight: bold; }
    @keyframes cursorBlink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

    .input-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 1.5rem;
      backdrop-filter: blur(12px);
      box-shadow: 0 4px 24px rgba(0,0,0,0.06);
      transition: border-color 0.2s;
    }

    .dark .input-card {
      box-shadow: 0 4px 24px rgba(0,0,0,0.3);
    }

    .input-card:focus-within {
      border-color: rgba(108,99,255,0.5);
    }

    .input-label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.75rem;
    }

    .log-textarea {
      width: 100%;
      background: #0a0a0f;
      color: #4ade80;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.82rem;
      line-height: 1.7;
      padding: 1rem;
      border-radius: 10px;
      border: 1px solid #1f2937;
      resize: vertical;
      outline: none;
      transition: border-color 0.2s;
      min-height: 160px;
    }

    .log-textarea:focus { border-color: #6c63ff; }
    .log-textarea::placeholder { color: #374151; }

    .analyze-btn {
      width: 100%;
      margin-top: 1rem;
      padding: 0.9rem 1.5rem;
      background: linear-gradient(135deg, #6c63ff, #8b5cf6);
      color: white;
      font-weight: 700;
      font-size: 1rem;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s ease;
      letter-spacing: 0.02em;
      position: relative;
      overflow: hidden;
    }

    .analyze-btn:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(108,99,255,0.4); }
    .analyze-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

    .split-layout {
      display: none;
      gap: 1rem;
    }

    .split-layout.visible {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    @media (max-width: 768px) {
      .split-layout.visible {
        grid-template-columns: 1fr;
      }
    }

    .result-card {
      border-radius: 16px;
      padding: 1.25rem;
      border: 1px solid;
      display: flex;
      flex-direction: column;
      min-height: 300px;
    }

    .error-card {
      background: rgba(10,10,15,0.95);
      border-color: rgba(239,68,68,0.25);
    }

    .solution-card {
      background: rgba(10,10,15,0.95);
      border-color: rgba(74,222,128,0.25);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 0.75rem;
      margin-bottom: 0.75rem;
      border-bottom: 1px solid #1f2937;
    }

    .card-title {
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .card-title.error { color: #f87171; }
    .card-title.solution { color: #4ade80; }

    .card-action-btn {
      background: #1f2937;
      color: #9ca3af;
      border: none;
      padding: 4px 10px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.75rem;
      transition: all 0.15s;
    }
    .card-action-btn:hover { background: #374151; color: #e5e7eb; }

    .card-content {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.78rem;
      line-height: 1.8;
      overflow-y: auto;
      flex: 1;
      color: #9ca3af;
    }

    .card-content::-webkit-scrollbar { width: 4px; }
    .card-content::-webkit-scrollbar-track { background: #111827; }
    .error-card .card-content::-webkit-scrollbar-thumb { background: #ef4444; border-radius: 2px; }
    .solution-card .card-content::-webkit-scrollbar-thumb { background: #4ade80; border-radius: 2px; }

    .err-line {
      display: block;
      padding: 2px 8px;
      border-left: 2px solid #ef4444;
      background: rgba(239,68,68,0.08);
      color: #fca5a5;
      border-radius: 2px;
      margin: 2px 0;
    }
    .normal-line { display: block; padding: 2px 4px; }

    /* AI Formatting Styles */
    .sol-heading {
      color: #a78bfa;
      font-size: 0.85rem;
      font-weight: 700;
      margin: 1.2rem 0 0.5rem;
      padding-bottom: 4px;
      border-bottom: 1px solid #1f2937;
      display: block;
    }
    .sol-cmd {
      background: rgba(74,222,128,0.1);
      color: #4ade80;
      padding: 2px 7px;
      border-radius: 4px;
      font-size: 0.8em;
      border: 1px solid rgba(74,222,128,0.25);
    }
    .sol-code-block {
      background: rgba(0,0,0,0.4);
      border-left: 2px solid #4ade80;
      padding: 12px;
      margin: 10px 0;
      border-radius: 4px;
      color: #4ade80;
      overflow-x: auto;
      white-space: pre-wrap;
    }
    .sol-bullet {
      display: flex;
      gap: 8px;
      margin: 6px 0;
      align-items: flex-start;
    }
    .sol-bullet-dot { color: #4ade80; flex-shrink: 0; margin-top: 2px; }
    .sol-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: #4ade80;
      color: #000;
      font-weight: 800;
      font-size: 0.65rem;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      flex-shrink: 0;
      margin-top: 2px;
    }
    .sol-bold { color: #e2e8f0; font-weight: 600; }

    @keyframes blink {
      0%, 100% { opacity: 0.2; }
      50% { opacity: 1; }
    }
    .dot1 { animation: blink 1.2s infinite 0s; }
    .dot2 { animation: blink 1.2s infinite 0.2s; }
    .dot3 { animation: blink 1.2s infinite 0.4s; }
  </style>

  <div style="max-width:1100px;margin:0 auto;padding:3rem 1.25rem 4rem;">
    <div style="text-align:center;margin-bottom:2.5rem;">
      <div class="hero-badge"><span>⚡</span> AI Powered Tool</div>
      <h1 class="page-title">Linux Log Explainer &<br><span>Automation Hub</span></h1>
      
      <p class="page-subtitle">
        <span id="typewriter-text"></span><span class="type-cursor">|</span>
      </p>
    </div>

    <div id="input-section" style="max-width:680px;margin:0 auto 2rem;">
      <div class="input-card">
        <div class="input-label">
          <span style="width:8px;height:8px;background:#ef4444;border-radius:50%;display:inline-block;"></span>
          Terminal Output / Error Log
        </div>
        <textarea id="log-input" class="log-textarea" rows="10" placeholder="[root@server ~]# systemctl start nginx..."></textarea>
        <button class="analyze-btn" id="submit-btn">Analyze Log with AI 🚀</button>
      </div>
    </div>

    <div id="split-layout" class="split-layout">
      <div class="result-card error-card">
        <div class="card-header">
          <span class="card-title error">
            <span style="width:8px;height:8px;background:#ef4444;border-radius:50%;display:inline-block;"></span>
            Error Log
          </span>
          <button class="card-action-btn" id="edit-btn">✏️ Edit</button>
        </div>
        <div class="card-content" id="error-display"></div>
      </div>

      <div class="result-card solution-card">
        <div class="card-header">
          <span class="card-title solution">
            <span style="width:8px;height:8px;background:#4ade80;border-radius:50%;display:inline-block;animation:blink 1.5s infinite;"></span>
            AI Solution
          </span>
          <button class="card-action-btn" id="copy-btn">📋 Copy</button>
        </div>
        <div class="card-content" id="ai-response"></div>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline>
  // ⚡ FIX: DOMContentLoaded hata diya hai. Ab buttons bina delay ke turant connect honge.
  document.getElementById('submit-btn')?.addEventListener('click', analyzeLog);
  document.getElementById('edit-btn')?.addEventListener('click', resetForm);
  document.getElementById('copy-btn')?.addEventListener('click', copyResponse);
  
  // Start the typing effect
  setTimeout(typeEffect, 500);

  // ⚡ Typewriter Logic Integration (9 Languages)
  const phrases = [
    "Apna failed service output ya error log paste karo — AI turant root cause aur exact fix batayega.", 
    "Paste your failed service output or error log — AI will instantly provide the root cause and fix.", 
    "अपना एरर लॉग पेस्ट करें — AI तुरंत सटीक कारण और समाधान बताएगा।", 
    "Pegue su registro de errores — la IA le dará la solución exacta al instante.", 
    "Collez votre journal d'erreurs — l'IA vous donnera instantanément la cause et la solution.", 
    "Fügen Sie Ihr Fehlerprotokoll ein — die KI liefert sofort die genaue Lösung.", 
    "エラーログを貼り付けてください — AIが瞬時に原因と解決策を提示します。", 
    "粘贴您的错误日志 — AI 将立即提供根本原因和解决方案。", 
    "Вставьте журнал ошибок — ИИ мгновенно предоставит точную причину и решение." 
  ];
  let phraseIndex = 0;
  let charIndex = 0;
  let isDeleting = false;

  function typeEffect() {
    const el = document.getElementById('typewriter-text');
    if (!el) return;
    const currentPhrase = phrases[phraseIndex];

    if (isDeleting) {
      el.textContent = currentPhrase.substring(0, charIndex - 1);
      charIndex--;
    } else {
      el.textContent = currentPhrase.substring(0, charIndex + 1);
      charIndex++;
    }

    let speed = isDeleting ? 25 : 45;

    if (!isDeleting && charIndex === currentPhrase.length) {
      speed = 2000;
      isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      phraseIndex = (phraseIndex + 1) % phrases.length;
      speed = 500;
    }
    setTimeout(typeEffect, speed);
  }

  function highlightErrors(text) {
    const errorKw = ['error','failed','failure','denied','fatal','critical','cannot','unable','not found','refused','timeout','invalid','no such','permission','exception','crash','killed','stopped','missing','bad'];
    return text.split('\n').map(line => {
      const lower = line.toLowerCase();
      const isErr = errorKw.some(k => lower.includes(k));
      const safe = line.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      return isErr ? `<span class="err-line">${safe}</span>` : `<span class="normal-line">${safe}</span>`;
    }).join('');
  }

  function renderSolution(text) {
    try {
      const parsed = JSON.parse(text);
      if (parsed.result) text = parsed.result;
    } catch(e) {}
    text = text.replace(/\\n/g, '\n');

    let html = text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

    html = html.replace(/```[a-z]*\n([\s\S]*?)```/g, '<div class="sol-code-block">$1</div>');
    html = html.replace(/^#{1,6}\s+(.+)$/gm, '<span class="sol-heading">$1</span>');
    html = html.replace(/\*\*([^*]+)\*\*/g, '<span class="sol-bold">$1</span>');
    html = html.replace(/`([^`]+)`/g, '<code class="sol-cmd">$1</code>');
    html = html.replace(/^[\*\-] (.+)$/gm, '<div class="sol-bullet"><span class="sol-bullet-dot">▸</span><span>$1</span></div>');
    html = html.replace(/^(\d+)\.\s+(.+)$/gm, '<div class="sol-bullet"><span class="sol-num">$1</span><span>$2</span></div>');
    html = html.replace(/\n/g, '<br>'); 

    return html;
  }

  async function analyzeLog() {
    const input = document.getElementById('log-input');
    const logData = input.value.trim();
    if (!logData) {
      input.style.borderColor = '#ef4444';
      setTimeout(() => input.style.borderColor = '#1f2937', 1500);
      return;
    }

    const btn = document.getElementById('submit-btn');
    btn.innerHTML = 'Analyzing <span class="dot1">●</span><span class="dot2">●</span><span class="dot3">●</span>';
    btn.disabled = true;

    document.getElementById('input-section').style.display = 'none';
    document.getElementById('split-layout').classList.add('visible');
    document.getElementById('error-display').innerHTML = highlightErrors(logData);

    const aiResponse = document.getElementById('ai-response');
    aiResponse.innerHTML = `<span style="color:#818cf8;">Connecting to AI Backend...</span>`;

    try {
      const response = await fetch('/api/analyze', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ logText: logData })
      });

      if (response.status === 429) {
        aiResponse.innerHTML = `
          <div style="background: rgba(239,68,68,0.1); border: 1px solid #ef4444; border-radius: 8px; padding: 15px; margin-top: 10px;">
            <span style="color: #fca5a5; font-weight: bold; display: block; font-size: 1rem; margin-bottom: 5px;">⚠️ Daily Limit Reached</span>
            <span style="color: #e5e7eb; font-size: 0.9rem;">Aaj ki free processing limit khatam ho chuki hai. Please kal wapas aakar try karein!</span>
          </div>`;
        btn.innerHTML = 'Analyze Log with AI 🚀';
        btn.disabled = false;
        return; 
      }

      if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

      aiResponse.innerHTML = ""; 
      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let fullText = "";

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        
        const chunk = decoder.decode(value, { stream: true });
        fullText += chunk;
        aiResponse.innerHTML = renderSolution(fullText);
      }

    } catch (err) {
      aiResponse.innerHTML = `<span style="color:#f87171;">⚠️ Error: ${err.message}</span>`;
    } finally {
      btn.innerHTML = 'Analyze Log with AI 🚀';
      btn.disabled = false;
    }
  }

  function copyResponse() {
    const aiResp = document.getElementById('ai-response');
    let textToCopy = aiResp.innerText;
    
    textToCopy = textToCopy.replace(/▸ /g, '- ').replace(/<br>/g, '\n');
    
    navigator.clipboard.writeText(textToCopy).then(() => {
      const btn = document.getElementById('copy-btn');
      btn.innerText = '✅ Copied!';
      setTimeout(() => btn.innerText = '📋 Copy', 2000);
    });
  }

  function resetForm() {
    document.getElementById('input-section').style.display = 'block';
    document.getElementById('split-layout').classList.remove('visible');
  }
</script>