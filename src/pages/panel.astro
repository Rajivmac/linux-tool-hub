---
import Navbar from '../components/Navbar.astro';
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="System Control Panel | Tool Hub">
  <style>
    /* Emerald/Green Theme for System Health & Panel */
    .hero-badge { display: inline-flex; align-items: center; gap: 6px; background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3); color: #10b981; font-size: 0.75rem; font-weight: 600; padding: 4px 12px; border-radius: 999px; text-transform: uppercase; margin-bottom: 1.2rem; }
    .page-title { font-size: clamp(1.8rem, 5vw, 2.8rem); font-weight: 800; color: #ffffff; line-height: 1.15; margin-bottom: 0.75rem; }
    .page-title span { color: #10b981; }
    
    .type-cursor { display: inline-block; width: 2px; color: #10b981; animation: cursorBlink 0.8s step-end infinite; margin-left: 2px; font-weight: bold; }
    @keyframes cursorBlink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

    .dashboard-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; max-width: 1000px; margin: 0 auto 2rem; }
    
    .panel-card { background: #111827; border: 1px solid #1f2937; border-radius: 16px; padding: 1.5rem; display: flex; flex-direction: column; }
    .card-title { color: #e5e7eb; font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; display: flex; align-items: center; gap: 8px; border-bottom: 1px solid #1f2937; padding-bottom: 0.5rem; }
    
    .std-input { width: 100%; background: #0a0a0f; color: #10b981; padding: 0.8rem; border: 1px solid #374151; border-radius: 8px; font-family: 'JetBrains Mono', monospace; margin-bottom: 1rem; outline: none; transition: border-color 0.2s; }
    .std-input:focus { border-color: #10b981; }

    .btn-group { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .panel-btn { flex: 1; padding: 0.6rem 1rem; background: #1f2937; color: #e5e7eb; border: 1px solid #374151; border-radius: 8px; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.2s; white-space: nowrap; }
    .panel-btn:hover { background: #10b981; color: #000; border-color: #10b981; }

    /* Terminal Output Box */
    .terminal-container { max-width: 1000px; margin: 0 auto; background: #000; border: 1px solid #10b981; border-radius: 12px; overflow: hidden; }
    .terminal-header { background: #0a0a0f; padding: 8px 15px; border-bottom: 1px solid #1f2937; display: flex; gap: 6px; }
    .mac-dot { width: 12px; height: 12px; border-radius: 50%; }
    .terminal-body { padding: 1.5rem; font-family: 'JetBrains Mono', monospace; color: #4ade80; font-size: 0.95rem; line-height: 1.6; min-height: 100px; white-space: pre-wrap; }
    .cmd-prompt { color: #f472b6; }
  </style>

  <div style="max-width:1100px;margin:0 auto;padding:3rem 1.25rem 4rem;">
    <div style="text-align:center;margin-bottom:2.5rem;">
      <div class="hero-badge"><span>⚙️</span> Secure No-AI Engine</div>
      <h1 class="page-title">Server Control<br><span>Dashboard</span></h1>
      
      <p style="color: #9ca3af; max-width: 550px; margin: 0 auto; line-height: 1.6; min-height: 48px;">
        <span id="typewriter-text"></span><span class="type-cursor">|</span>
      </p>
    </div>

    <Navbar currentPath="/panel" />

    <div class="dashboard-grid">
      
      <div class="panel-card">
        <div class="card-title">🔌 Service Manager</div>
        <input type="text" id="svc-name" class="std-input" placeholder="Service Name (e.g., httpd, sshd)">
        <div class="btn-group">
          <button class="panel-btn" onclick="genCmd('systemctl start ' + getVal('svc-name', 'httpd'))">Start</button>
          <button class="panel-btn" onclick="genCmd('systemctl restart ' + getVal('svc-name', 'httpd'))">Restart</button>
          <button class="panel-btn" onclick="genCmd('systemctl status ' + getVal('svc-name', 'httpd'))">Status</button>
        </div>
      </div>

      <div class="panel-card">
        <div class="card-title">👥 User Admin</div>
        <input type="text" id="usr-name" class="std-input" placeholder="Username (e.g., developer1)">
        <div class="btn-group">
          <button class="panel-btn" onclick="genCmd('useradd -m ' + getVal('usr-name', 'newuser') + ' && passwd ' + getVal('usr-name', 'newuser'))">Create User</button>
          <button class="panel-btn" onclick="genCmd('usermod -aG wheel ' + getVal('usr-name', 'newuser'))">Give Sudo</button>
          <button class="panel-btn" onclick="genCmd('usermod -L ' + getVal('usr-name', 'newuser'))">Lock Acc</button>
        </div>
      </div>

      <div class="panel-card">
        <div class="card-title">🩺 System Health</div>
        <p style="color:#9ca3af; font-size:0.85rem; margin-bottom:1rem;">Generate commands to check server vitals instantly.</p>
        <div class="btn-group" style="margin-top: auto;">
          <button class="panel-btn" onclick="genCmd('df -hT')">Disk Space</button>
          <button class="panel-btn" onclick="genCmd('free -m')">RAM Usage</button>
          <button class="panel-btn" onclick="genCmd('ss -tulpn')">Open Ports</button>
        </div>
      </div>

    </div>

    <div class="terminal-container">
      <div class="terminal-header">
        <div class="mac-dot" style="background:#ef4444;"></div>
        <div class="mac-dot" style="background:#f59e0b;"></div>
        <div class="mac-dot" style="background:#10b981;"></div>
      </div>
      <div class="terminal-body" id="term-output">
        <span style="color:#6b7280;"># Output will appear here...</span>
      </div>
    </div>

  </div>
</MainLayout>

<script is:inline>
  // 1. Typewriter Logic
  setTimeout(typeEffect, 500);
  const phrases = [
    "Zaroori system administration commands turant generate karo.", 
    "Generate essential system administration commands instantly.", 
    "आवश्यक सिस्टम एडमिनिस्ट्रेशन कमांड्स तुरंत जनरेट करें।", 
    "Genere comandos esenciales de administración del sistema al instante.", 
    "Générez instantanément des commandes d'administration système essentielles.", 
    "Generieren Sie sofort wichtige Systemverwaltungsbefehle.", 
    "重要なシステム管理コマンドを即座に生成します。", 
    "立即生成重要的系统管理命令。", 
    "Мгновенно генерируйте основные команды системного администрирования." 
  ];
  let phraseIndex = 0; let charIndex = 0; let isDeleting = false;

  function typeEffect() {
    const el = document.getElementById('typewriter-text');
    if (!el) return;
    const currentPhrase = phrases[phraseIndex];

    if (isDeleting) {
      el.textContent = currentPhrase.substring(0, charIndex - 1);
      charIndex--;
    } else {
      el.textContent = currentPhrase.substring(0, charIndex + 1);
      charIndex++;
    }

    let speed = isDeleting ? 25 : 45;
    if (!isDeleting && charIndex === currentPhrase.length) {
      speed = 2000; isDeleting = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false; phraseIndex = (phraseIndex + 1) % phrases.length; speed = 500;
    }
    setTimeout(typeEffect, speed);
  }

  // 2. Command Generator Logic
  function getVal(id, fallback) {
    const val = document.getElementById(id).value.trim();
    return val ? val : fallback;
  }

  function genCmd(cmd) {
    const term = document.getElementById('term-output');
    term.innerHTML = `<span class="cmd-prompt">[root@server ~]#</span> ${cmd}\n<span style="color:#9ca3af; font-size:0.8rem;"># Copy and run this command on your Linux server.</span>`;
  }
</script>