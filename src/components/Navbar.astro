---
const { currentPath } = Astro.props;

const tabs = [
  { name: '🧠 AI Log Explainer', path: '/' },
  { name: '🤖 Bash Builder', path: '/bash-builder' },
  { name: '⏳ Cronjob Gen', path: '/cronjob' },
  { name: '🧮 Chmod Calc', path: '/chmod' },
  { name: '💾 LVM Planner', path: '/lvm-planner' },
  { name: '🌐 Network Gen', path: '/network-config' },
  { name: '⚙️ System Panel', path: '/panel' },
];
---

<style>
  .tool-tabs { 
    display: flex; 
    justify-content: center; 
    gap: 0.8rem; 
    margin-bottom: 2.5rem; 
    flex-wrap: wrap; 
  }
  
  .tab-link { 
    display: inline-flex; 
    align-items: center; 
    gap: 6px; 
    padding: 8px 16px; 
    background: rgba(0, 0, 0, 0.05); 
    border: 1px solid #e5e7eb; 
    border-radius: 10px; 
    color: #374151; 
    font-size: 0.85rem; 
    font-weight: 600; 
    text-decoration: none; 
    transition: all 0.2s ease; 
  }
  .tab-link:hover { 
    background: rgba(0, 0, 0, 0.1); 
    transform: translateY(-2px); 
  }
  .tab-link.active { 
    background: rgba(108, 99, 255, 0.1); 
    border-color: rgba(108, 99, 255, 0.4); 
    color: #6c63ff; 
    box-shadow: 0 4px 15px rgba(108, 99, 255, 0.15); 
  }

  :global(.dark) .tab-link {
    background: rgba(31, 41, 55, 0.4); 
    border-color: #1f2937; 
    color: #9ca3af; 
  }
  :global(.dark) .tab-link:hover {
    background: rgba(31, 41, 55, 0.8); 
    color: #e5e7eb; 
  }
  :global(.dark) .tab-link.active {
    color: #8b85ff;
  }

  .support-btn {
    padding: 6px 14px;
    font-size: 0.85rem;
    font-weight: 700;
    color: white;
    background: linear-gradient(135deg, #22c55e, #16a34a);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: inherit;
  }
  .support-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(34,197,94,0.4);
  }

  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.8);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }

  .modal-box {
    background: #111827;
    border: 1px solid #374151;
    border-radius: 20px;
    padding: 2rem 1.5rem;
    text-align: center;
    max-width: 300px;
    width: 90%;
    animation: popIn 0.2s ease;
  }

  @keyframes popIn {
    from { transform: scale(0.9); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  .modal-close-btn {
    margin-top: 1.25rem;
    background: #374151;
    color: #9ca3af;
    border: none;
    padding: 8px 20px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.85rem;
    font-family: inherit;
    transition: background 0.2s;
  }
  .modal-close-btn:hover {
    background: #4b5563;
    color: #e5e7eb;
  }
</style>

<div class="tool-tabs">
  {tabs.map((tab) => (
    <a href={tab.path} class={`tab-link ${currentPath === tab.path ? 'active' : ''}`}>
      {tab.name}
    </a>
  ))}
</div>

<div class="flex items-center justify-center gap-5 mt-8 mb-6 w-full">
  
  <a href="https://github.com/Rajivmac/linux-tool-hub" target="_blank" 
    class="text-gray-600 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors" 
    title="View Source on GitHub">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
    </svg>
  </a>

  <a href="mailto:rajivmac09@gmail.com?subject=Feedback for Linux ToolHub" 
    class="text-sm font-semibold text-gray-600 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors">
    Feedback
  </a>

  <button class="support-btn" onclick="document.getElementById('upi-modal').style.display='flex'">
    💖 Support
  </button>
</div>

<div id="upi-modal" class="modal-overlay" onclick="this.style.display='none'">
  <div class="modal-box" onclick="event.stopPropagation()">
    
    <p style="color:#9ca3af;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:0.4rem;">
      Support My Work
    </p>
    <h3 style="color:white;font-weight:800;font-size:1.15rem;margin-bottom:1.25rem;">
      ☕ Buy Me a Chai
    </h3>

    <div style="background:#1f2937;border-radius:12px;padding:0.75rem;display:inline-block;margin-bottom:1rem;">
      <img src="/upi-qr.jpg" alt="UPI QR Code" 
        style="width:190px;height:190px;border-radius:8px;display:block;object-fit:cover;"/>
    </div>

    <p style="color:#9ca3af;font-size:0.78rem;margin-bottom:0.5rem;">
      Scan with GPay, PhonePe, or any UPI app
    </p>

    <div style="background:rgba(74,222,128,0.08);border:1px solid rgba(74,222,128,0.2);border-radius:8px;padding:6px 16px;display:inline-block;margin-bottom:0.25rem;">
      <span style="color:#4ade80;font-weight:700;font-size:0.88rem;">
        9518017611@upi
      </span>
    </div>

    <button class="modal-close-btn" onclick="document.getElementById('upi-modal').style.display='none'">
      Close ✕
    </button>
  </div>
</div>